---
import Arrow from './Arrow.astro';
---
<header class="site-header">
  <div class="container wrap">
    <nav aria-label="メインメニュー" class="nav">
      <a href="#top" class="logo">
        <svg aria-hidden="true" width="34" height="34" viewBox="0 0 48 48" fill="none" stroke="#A8322A" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M24 4v6M24 10c-3 4-5 7-5 11h10c0-4-2-7-5-11z" /><path d="M15 21h18M13 27h22l-3-6H16z" /><path d="M10 34h28l-3-7H13z" /><path d="M8 42h32M12 34v8M36 34v8M20 34v8M28 34v8" /></svg>
        <span class="logo-text">
          <span class="logo-main">ランパーン留学</span>
          <span class="logo-sub thai">ลำปาง · LAMPANG ELECTIVE</span>
        </span>
      </a>
      <a href="#about" class="nav-link">ランパーン病院とは？</a>
      <a href="#flow" class="nav-link tab">留学までの流れ</a>
      <a href="#faq" class="nav-link tab">よくある質問</a>
    </nav>
    <a href="#contact" class="cta">相談する <Arrow /></a>
  </div>
</header>

<style>
  .site-header { padding: 20px 24px 0; display: flex; justify-content: center; }
  .wrap { width: 100%; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
  .nav {
    flex: 1 1 640px; min-width: 0; background: #fff; border-radius: 14px;
    box-shadow: 0 6px 24px rgba(90, 60, 20, 0.12); padding: 10px 12px 10px 18px;
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px;
  }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); margin-right: 8px; }
  .logo-text { display: flex; flex-direction: column; line-height: 1.2; }
  .logo-main { font-size: 15px; font-weight: 900; }
  .logo-sub { font-size: 11px; color: var(--brown); }
  .nav-link { text-decoration: none; color: var(--ink); font-weight: 700; font-size: 14px; padding: 10px 6px; }
  .nav-link.tab { padding: 10px 16px; background: var(--cream); border-radius: 8px; }
  .nav-link:hover { color: var(--red); }
  .cta {
    flex: 0 0 auto; display: inline-flex; align-items: center; gap: 10px; min-height: 56px; padding: 0 26px;
    background: var(--cta); color: #fff; text-decoration: none; font-weight: 700; font-size: 15px;
    border-radius: 14px; box-shadow: 0 6px 24px rgba(90, 60, 20, 0.14);
  }
  .cta:hover { background: var(--cta-hover); color: #fff; }
</style>
