---
// タイ北部の布をモチーフにした帯。variant で配色を切り替えます。
interface Props { variant?: 'red' | 'green'; id: string }
const { variant = 'red', id } = Astro.props;
const base = variant === 'red' ? '#A8322A' : '#145A41';
const right = variant === 'red' ? '#145A41' : '#A8322A';
---
<svg aria-hidden="true" width="100%" height="28" style="display: block">
  <defs>
    <pattern id={id} width="48" height="28" patternUnits="userSpaceOnUse">
      <rect width="48" height="28" fill={base} />
      <rect y="0" width="48" height="4" fill="#C8963E" />
      <rect y="24" width="48" height="4" fill="#C8963E" />
      <polygon points="0,22 12,8 24,22" fill="#F4A93B" />
      <polygon points="24,22 36,8 48,22" fill={right} />
      <polygon points="24,9 27,13 24,17 21,13" fill="#FFF9EF" />
      <polygon points="0,9 3,13 0,17 -3,13" fill="#FFF9EF" />
      <polygon points="48,9 51,13 48,17 45,13" fill="#FFF9EF" />
    </pattern>
  </defs>
  <rect width="100%" height="28" fill={`url(#${id})`} />
</svg>
